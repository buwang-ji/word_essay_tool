# =============================================================================
#  配置模板 —— 复制本文件为 .env 后填写自己的值
# =============================================================================
#  操作步骤：
#      Windows:      copy .env.example .env
#      macOS/Linux:  cp .env.example .env
#  然后编辑 .env，把 sk-你的密钥 换成你自己的真实 Key。
#
#  .env 已被 .gitignore 排除，不会被提交到 GitHub；
#  系统环境变量优先级高于 .env（同名时以系统环境变量为准）。
# =============================================================================

# 【必填】DeepSeek API Key，申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-你的密钥

# 【选填】以下项留空则使用脚本内置默认值

# 模型名（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# 每天生成几篇短文（默认 2，所有单词按篇数均分）
# ESSAYS_PER_DAY=2

# 每篇短文的目标词数系数：目标词数 = 本篇单词数 × 该系数（默认 6）
# ESSAY_WORDS_PER_TARGET=6

# 短文保存目录（默认脚本同级目录下的「短文」；支持绝对路径）
# OUTPUT_DIR=短文

# 备份保留份数（默认 14）
# BACKUP_KEEP=14

# 生成后是否自动用 VS Code 打开（默认 true；不想自动打开就设 false）
# AUTO_OPEN_VSCODE=true

# VS Code 可执行文件路径
# 脚本会先找 PATH 里的 code 命令，再试常见安装位置（Windows/macOS/Linux）；
# 如果你的 VS Code 装在自定义目录（路径带空格或中文），在这里指定：
# VSCODE_PATH=D:\vscode\vscode wenjian\Microsoft VS Code\bin\code.cmd
